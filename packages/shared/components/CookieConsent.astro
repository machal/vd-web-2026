---
/** Lightweight GDPR cookie banner — no jQuery. EN sites only (wired from BaseLayout). */
---

<div
  id="cookie-consent"
  class="cookie-consent"
  role="dialog"
  aria-label="Cookie consent"
  aria-live="polite"
  hidden
>
  <div class="cookie-consent__inner box">
    <p class="cookie-consent__text f-6 mb-05">
      This site uses essential cookies and, with your consent, analytics cookies (Google Analytics).
      See our <a href="/cookies">Cookie Policy</a> and <a href="/privacy">Privacy Policy</a>.
    </p>
    <p class="cookie-consent__actions mb-0">
      <button type="button" class="button" data-cookie-action="essential">Essential only</button>
      {' '}
      <button type="button" class="button" data-cookie-action="all">Accept analytics</button>
    </p>
  </div>
</div>

<style>
  .cookie-consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    padding: 1rem;
    pointer-events: none;
  }

  .cookie-consent:not([hidden]) {
    pointer-events: auto;
  }

  .cookie-consent__inner {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1rem 1.25rem;
    box-shadow: 0 0.25rem 1rem rgba(0, 0, 0, 0.15);
  }

  .cookie-consent__actions .button {
    margin-top: 0.25rem;
  }
</style>

<script>
  const STORAGE_KEY = 'michalek-cookie-consent';

  function getConsent(): string | null {
    try {
      return localStorage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  }

  function setConsent(value: 'essential' | 'all') {
    try {
      localStorage.setItem(STORAGE_KEY, value);
    } catch {
      // private browsing — still hide banner for this session
    }
    document.dispatchEvent(
      new CustomEvent('cookie-consent', { detail: { level: value } }),
    );
  }

  function initCookieConsent() {
    const banner = document.getElementById('cookie-consent');
    if (!banner) return;

    const existing = getConsent();
    if (existing) {
      banner.hidden = true;
      document.dispatchEvent(
        new CustomEvent('cookie-consent', { detail: { level: existing } }),
      );
      return;
    }

    banner.hidden = false;

    banner.querySelectorAll('[data-cookie-action]').forEach((button) => {
      button.addEventListener('click', () => {
        const action = button.getAttribute('data-cookie-action');
        if (action === 'essential' || action === 'all') {
          setConsent(action);
          banner.hidden = true;
        }
      });
    });
  }

  initCookieConsent();
</script>
