---
import {
  getAuthorProfileCopy,
  type AuthorProfileLocale,
} from '@vd/shared/content/author-profile';
import type { SiteConfig } from '@vd/shared/types';

interface Props {
  locale?: AuthorProfileLocale;
  siteConfig?: SiteConfig;
}

const locale: AuthorProfileLocale =
  Astro.props.locale ?? Astro.props.siteConfig?.locale ?? 'cs';

const { heading, bioLines } = getAuthorProfileCopy(locale);
---

<div class="page-head lector__head lector__head--photo-bg">
  <div class="lector__head-content">
    <h1 class="lector__head-name">
      {heading}
    </h1>
    <div class="lector__head-perex">
      <p>
        {bioLines.map((line, index) => (
          <>
            {index > 0 && <br />}
            {line}
          </>
        ))}
      </p>
    </div>
  </div>
</div>
