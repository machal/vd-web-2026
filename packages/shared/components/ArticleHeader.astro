---
interface Props {
  title: string;
  author?: string;
  date?: Date;
  locale?: 'cs' | 'en';
}

const { title, author = 'Martin Michálek', date, locale = 'cs' } = Astro.props;
const hasActions = Astro.slots.has('actions');

function formatDate(date: Date | undefined): string {
  if (!date) return '';
  return new Intl.DateTimeFormat(locale === 'en' ? 'en-GB' : 'cs-CZ', {
    day: 'numeric',
    month: locale === 'en' ? 'short' : 'numeric',
    year: 'numeric',
  }).format(date);
}
---

<div class="page-head page-head--subhead">
  <h1>{title}</h1>
</div>

<div class:list={['page-subhead', { 'page-subhead--split': hasActions }]}>
  <p class="mb-0 page-subhead__meta">
    <a class="page-subhead__author" href="/martin">
      <span class="avatar avatar--tiny avatar--inline mr-05">
        <img src="/assets/img/content/lectors/shoulders-martin-michalek_50x50.png" alt="Martin Michálek" width="50" height="50" class="avatar__image" />
      </span>
      {author}
    </a>
    {date && (
      <span class="page-subhead__date">
        &nbsp;&ndash;
        {formatDate(date)}
      </span>
    )}
  </p>
  {hasActions && (
    <div class="page-subhead__actions">
      <slot name="actions" />
    </div>
  )}
</div>

<style>
  .page-subhead--split {
    justify-content: space-between;
    gap: 1rem;
  }

  .page-subhead--split .page-subhead__meta {
    flex: 1;
    min-width: 0;
  }

  .page-subhead__actions {
    flex-shrink: 0;
    text-align: right;
  }

  .page-subhead__actions :global(.language-switch) {
    margin: 0;
  }

  .page-subhead__actions :global(.language-switch__inner) {
    color: inherit;
    margin-bottom: 0;
  }

  .page-subhead__actions :global(.language-switch__link) {
    color: #fff;
  }
</style>
