---
import {
  getMartinContactCopy,
  getMartinContactSocials,
  martinContactEmail,
  martinContactPhone,
} from '@vd/shared/content/martin-contact';
import type { SiteConfig } from '@vd/shared/types';

interface Props {
  siteConfig?: SiteConfig;
}

const locale = Astro.props.siteConfig?.locale ?? 'cs';
const t = getMartinContactCopy(locale);
const socials = getMartinContactSocials(locale);
---

<div class="content">
  <h2 class="ta-c" id={t.sectionId}>
    <a href={`#${t.sectionId}`}>{t.heading}</a>
  </h2>

  <p class="ta-c article mb-1 martin-contact__details">
    {t.emailPrefix}{' '}
    <a href={`mailto:${martinContactEmail}`}>{martinContactEmail}</a>
    {' – '}
    {t.phonePrefix}{' '}
    <a href={martinContactPhone.href}>{martinContactPhone.display}</a>
  </p>

  <p class="ta-c mb-2 martin-contact__socials">
    {
      socials.map((social) => (
        <a
          href={social.href}
          class="martin-contact__social-link"
          aria-label={social.label}
          rel="noopener noreferrer"
          target="_blank"
        >
          {social.id === 'linkedin' && (
            <svg viewBox="0 0 30 30" xmlns="http://www.w3.org/2000/svg" class="martin-contact__icon" aria-hidden="true">
              <path d="M15,0C6.717,0,0,6.717,0,15s6.717,15,15,15s15-6.717,15-15S23.283,0,15,0z M10.641,22.676H6.988V11.685
                h3.652V22.676z M8.814,10.184H8.791c-1.227,0-2.02-0.844-2.02-1.899c0-1.079,0.817-1.899,2.067-1.899s2.019,0.82,2.042,1.899
                C10.881,9.34,10.089,10.184,8.814,10.184z M23.813,22.676h-3.651v-5.88c0-1.478-0.528-2.485-1.851-2.485
                c-1.01,0-1.61,0.68-1.875,1.335c-0.097,0.235-0.121,0.563-0.121,0.893v6.139h-3.652c0,0,0.048-9.959,0-10.992h3.652v1.556
                c0.486-0.749,1.354-1.814,3.293-1.814c2.402,0,4.205,1.57,4.205,4.946V22.676L23.813,22.676z" />
            </svg>
          )}
          {social.id === 'x' && (
            <svg viewBox="0 0 30 30" xmlns="http://www.w3.org/2000/svg" class="martin-contact__icon" aria-hidden="true">
              <path d="M15,0C6.716,0,0,6.716,0,15c0,8.284,6.716,15,15,15s15-6.716,15-15C30,6.716,23.284,0,15,0z M18.56,8.5l2.19,0l-4.78,5.47l5.62,7.43h-4.08l-3.64-4.81l-4.09,4.81H7.59l5.11-5.85L7.37,8.5h4.19l3.29,4.35L18.56,8.5z M18.12,20.13l-8.44-10.35h1.46l8.44,10.35H18.12z" />
            </svg>
          )}
          {social.id === 'facebook' && (
            <svg viewBox="0 0 30 30" xmlns="http://www.w3.org/2000/svg" class="martin-contact__icon" aria-hidden="true">
              <path d="M15,0C6.716,0,0,6.716,0,15s6.716,15,15,15s15-6.716,15-15S23.284,0,15,0z M19.233,12.764l-0.002,2.969
                h-2.938v7.617h-3.065V15.73h-2.563v-2.968h2.563v-2.188c0-2.542,1.553-3.924,3.817-3.924l2.29,0.004v2.769h0.002l-1.573,0.001
                c-1.232,0-1.47,0.585-1.47,1.445v1.895H19.233z" />
            </svg>
          )}
          {social.id === 'instagram' && (
            <svg viewBox="0 0 30 30" xmlns="http://www.w3.org/2000/svg" class="martin-contact__icon" aria-hidden="true">
              <path d="M15,0C6.716,0,0,6.716,0,15s6.716,15,15,15s15-6.716,15-15S23.284,0,15,0z M21.6,8.4H8.4c-0.552,0-1,0.448-1,1v12.2
                c0,0.552,0.448,1,1,1h13.2c0.552,0,1-0.448,1-1V9.4C22.6,8.848,22.152,8.4,21.6,8.4z M15,19.05c-2.238,0-4.05-1.812-4.05-4.05
                s1.812-4.05,4.05-4.05s4.05,1.812,4.05,4.05S17.238,19.05,15,19.05z M21.75,10.95c-0.414,0-0.75-0.336-0.75-0.75
                s0.336-0.75,0.75-0.75s0.75,0.336,0.75,0.75S22.164,10.95,21.75,10.95z" />
            </svg>
          )}
          {social.id === 'bluesky' && (
            <svg viewBox="0 0 30 30" xmlns="http://www.w3.org/2000/svg" class="martin-contact__icon" aria-hidden="true">
              <path d="M15,0C6.716,0,0,6.716,0,15s6.716,15,15,15s15-6.716,15-15S23.284,0,15,0z M21.2,11.4c0.1,3.4-2.3,8.1-6.5,8.1
                c-1.3,0-2.3-0.7-3.2-1.5c-0.6,0.5-1.2,0.9-2,0.9c-0.3,0-0.5-0.1-0.7-0.2c0.8-0.5,1.5-1.1,2-1.9c-1.7,0.1-3.1-1.4-3.6-3.1
                c0.5,0.3,1.1,0.5,1.7,0.5c-1-0.7-1.6-1.9-1.6-3.2c0-0.7,0.2-1.4,0.5-2c1.9,2.3,4.7,3.8,7.8,4c-0.1-0.4-0.1-0.8-0.1-1.2
                c0-2.9,2.3-5.2,5.2-5.2c1.5,0,2.9,0.6,3.9,1.7C20.4,9.3,19.3,9,18.2,9c-1.8,0-3.3,1.2-3.8,2.9C13.4,11.1,12.2,10.5,11,10.5
                c-1.8,0-3.3,1.5-3.3,3.3c0,0.3,0,0.5,0.1,0.8C6.4,14.1,5,12.5,5,10.6c0-2.5,2-4.6,4.6-4.6c1.2,0,2.3,0.5,3.1,1.2
                c0.8-0.8,1.9-1.2,3.1-1.2c2.5,0,4.6,2,4.6,4.6C20.4,11.1,20.8,11.3,21.2,11.4z" />
            </svg>
          )}
        </a>
      ))
    }
  </p>

  {
    t.legal && (
      <div class="small ta-c">
        {t.legal.map((line) => (
          <>
            {line}
            <br />
          </>
        ))}
      </div>
    )
  }
</div>

<style>
  .martin-contact__details {
    margin-bottom: 1rem;
  }

  .martin-contact__socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin: 0 0 1.5rem;
  }

  .martin-contact__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    text-decoration: none;
  }

  .martin-contact__social-link:hover,
  .martin-contact__social-link:focus {
    opacity: 0.75;
  }

  .martin-contact__icon {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    fill: var(--vd-text-color-lighter);
  }
</style>
