---
interface Props {
  currentLocale: 'cs' | 'en';
  alternateUrl?: string;
  className?: string;
}

const { currentLocale, alternateUrl, className = '' } = Astro.props;

const labels = {
  cs: { current: 'Česky', alternate: 'English' },
  en: { current: 'English', alternate: 'Česky' },
} as const;

const localeLabels = labels[currentLocale];
const alternateLocale = currentLocale === 'cs' ? 'en' : 'cs';
---

{alternateUrl && (
  <nav class={`language-switch ${className}`.trim()} aria-label="Language">
    <p class="language-switch__inner mb-0 f-6 text-color-lightest">
      <span class="language-switch__current" lang={currentLocale}>{localeLabels.current}</span>
      <span class="language-switch__sep" aria-hidden="true"> · </span>
      <a
        class="language-switch__link"
        href={alternateUrl}
        hreflang={alternateLocale}
        lang={alternateLocale}
        rel="alternate"
      >
        {localeLabels.alternate}
      </a>
    </p>
  </nav>
)}
