{
  "name": "vd-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "build:vzhurudolu": "turbo run build --filter=@vd/vzhurudolu",
    "build:michalek-dev": "turbo run build --filter=@vd/michalek-dev",
    "dev:vzhurudolu": "turbo run dev --filter=@vd/vzhurudolu",
    "validate:pairs": "node scripts/validate-content-pairs.mjs",
    "verify:phase6": "bash scripts/verify-phase6-content-pairing-i18n-seo.sh",
    "verify:phase7": "bash scripts/verify-phase7-content-adaptation.sh",
    "verify:phase14": "bash scripts/verify-phase14-v1-1-visual-polish.sh"
  },
  "devDependencies": {
    "turbo": "^2.9.16",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/machal/vd-web-2026.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "homepage": "https://github.com/machal/vd-web-2026#readme"
}
