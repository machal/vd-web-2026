{
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npx turbo run build --filter=@vd/vzhurudolu",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*\\.(ttf|otf|eot|woff2?))",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/node_modules/:path*", "statusCode": 404 },

    { "source": "/kniha-rwd", "destination": "/css-layout", "permanent": true },
    { "source": "/ebook-responzivni/:path*", "destination": "/kniha-responzivni-design/:path*", "permanent": true },
    { "source": "/ebook-responzivni", "destination": "/kniha-responzivni-design", "permanent": true },
    { "source": "/kniha-responzivni-design/kniha", "destination": "/kniha-responzivni-design", "permanent": true },
    { "source": "/kniha-responzivni-design/doplatek", "destination": "/kniha-responzivni-design", "permanent": true },
    { "source": "/ebook/:path*", "destination": "/ebook-css3/:path*", "permanent": true },
    { "source": "/ebook", "destination": "/ebook-css3", "permanent": true },

    { "source": "/p/:path*", "destination": "/prirucka/:path*", "permanent": true },
    { "source": "/b/:path*", "destination": "/blog/:path*", "permanent": true },
    { "source": "/k/:path*", "destination": "/kurzy/:path*", "permanent": true },
    { "source": "/v/:path*", "destination": "/video/:path*", "permanent": true },
    { "source": "/f/:path*", "destination": "/files/:path*", "permanent": true },
    { "source": "/vdampd/:path*", "destination": "/files/vdamp/demo/:path*", "permanent": true },

    { "source": "/checklist", "destination": "/prirucka/checklist", "permanent": true },

    { "source": "/kurzy/webovy-frontend", "destination": "/kurzy", "permanent": true },
    { "source": "/kurzy/webova-koderina", "destination": "/kurzy", "permanent": true },
    { "source": "/kurzy/pokrocily-responzivni-design", "destination": "/kurzy", "permanent": true },
    { "source": "/kurzy/rychlost-nacitani", "destination": "/kurzy", "permanent": true },
    { "source": "/frontend-kurz", "destination": "/kurzy", "permanent": true },
    { "source": "/kurzy/:path+", "destination": "/kurzy", "permanent": true },

    { "source": "/prirucka/css3", "destination": "/css/", "permanent": true },
    { "source": "/prirucka/css3/", "destination": "/css/", "permanent": true },
    { "source": "/prirucka/ostatni", "destination": "/", "permanent": true },
    { "source": "/prirucka/ostatni/", "destination": "/", "permanent": true },
