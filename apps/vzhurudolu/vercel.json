    { "source": "/prirucka/google-Search-Console", "destination": "/prirucka/google-search-console", "permanent": true },
    { "source": "/prirucka/kap-dokumet", "destination": "/prirucka/kap-dokument", "permanent": true },
    { "source": "/prirucka/css3-multiple-backgorunds", "destination": "/prirucka/css3-multiple-backgrounds", "permanent": true },
    { "source": "/prirucka/grid-template-areas", "destination": "/prirucka/css-grid-template-areas", "permanent": true },
    { "source": "/prirucka/css-media-queries", "destination": "/prirucka/css3-media-queries", "permanent": true },
