    { "source": "/prirucka/css3-multicolumn", "destination": "/prirucka/css-multicolumn", "permanent": true },
    { "source": "/prirucka/css3-flexbox", "destination": "/prirucka/css-flexbox", "permanent": true },
    { "source": "/prirucka/viewport-mobily", "destination": "/prirucka/viewport", "permanent": true },

    { "source": "/amp/:path+", "destination": "/:path+", "permanent": true },

    { "source": "/video/webinar-:id/objednavka", "destination": "/video", "permanent": true },
    { "source": "/video/webinar-:id", "destination": "/video", "permanent": true },
