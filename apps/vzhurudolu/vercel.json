    { "source": "/archiv/:path*", "destination": "/data/archiv/:path*", "permanent": true },
    { "source": "/blank/:path*", "destination": "/data/blank/:path*", "permanent": true },
    { "source": "/css-frameworks/:path*", "destination": "/data/css-frameworks/:path*", "permanent": true },
    { "source": "/fagaras/:path*", "destination": "/data/fagaras/:path*", "permanent": true },
    { "source": "/historie/:path*", "destination": "/data/historie/:path*", "permanent": true },
    { "source": "/images/:path*", "destination": "/data/images-till-2012/:path*", "permanent": true },
